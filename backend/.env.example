# WorkPilot AI Backend — Environment Variables
# Copy to .env for local development. NEVER commit .env to git.
# Lambda reads these from the function's environment configuration (set via Terraform/Console).

AWS_REGION=us-east-1

# Required: ID of the Bedrock Knowledge Base (created by terraform apply)
BEDROCK_KNOWLEDGE_BASE_ID=YOUR_KNOWLEDGE_BASE_ID_HERE

# Required: Bedrock foundation model ID for answer generation
# Example: anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# DynamoDB table names (must match Terraform output)
TASKS_TABLE_NAME=employee-ai-assistant-tasks
REMINDERS_TABLE_NAME=employee-ai-assistant-employee_reminders
CONVERSATIONS_TABLE_NAME=employee-ai-assistant-conversations

# CORS: set to your deployed frontend origin in production
FRONTEND_ORIGIN=http://localhost:5173

# Optional: minimum relevance score (0.0-1.0) for KB results
# Results below this threshold will trigger "not found" response
BEDROCK_RELEVANCE_THRESHOLD=0.4
