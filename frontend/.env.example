# WorkPilot AI Frontend — Environment Variables
# Copy to .env for local development. NEVER commit .env to git.
# Set VITE_API_BASE_URL to your deployed API Gateway URL after terraform apply.

# Required: API Gateway URL from Terraform output (api_gateway_url)
VITE_API_BASE_URL=https://YOUR_API_GATEWAY_ID.execute-api.us-east-1.amazonaws.com
